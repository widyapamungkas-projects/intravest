{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "allowJs": false, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src/client", "src/shared", "vite.config.ts"]
}
