# Alamat publik dashboard (dipakai untuk cookie Secure dan cek Origin)
PUBLIC_URL=https://admin.contoh.com
PORT=8787

# Repo konten. Token = fine-grained PAT, hanya repo ini, izin Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=widyapamungkas-projects/intravest
GITHUB_BRANCH=main

# Login: email + password, lalu kode OTP 6 digit lewat Resend
RESEND_API_KEY=
MAIL_FROM=Intravest CMS <cms@domainmu.com>
MAX_ADMINS=3

# Folder data (SQLite akun/sesi). Di Docker: volume /data
DATA_DIR=./data
