---
import '../styles/global.css';
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { alternatePath, htmlLang, routePath, type Locale } from '../i18n';
import { ui } from '../ui';
import { site } from '../site';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Page exists in this locale only: no hreflang alternate, and the language switcher goes to the other locale's stories index. */
  noAlternate?: boolean;
  ogType?: 'website' | 'article';
  /** Path or absolute URL of the social share image. Defaults to /og/default.jpg (1200x630). */
  ogImage?: string;
  /** Structured data for this page, rendered in <head>. Pages may also render their own JSON-LD script in the body. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (used for the 404 page). */
  noindex?: boolean;
  /** wa.me link for the floating WhatsApp button, pre-filled for this page (package, destination). */
  waHref?: string;
}
const {
  locale,
  title,
  description = site.description[locale],
  noAlternate = false,
  ogType = 'website',
  ogImage = '/og/default.jpg',
  jsonLd,
  noindex = false,
  waHref,
} = Astro.props;
const pathname = Astro.url.pathname;
const alt = noAlternate ? null : alternatePath(pathname);
const switchHref = noAlternate ? routePath(locale === 'en' ? 'id' : 'en', 'travel-stories') : undefined;
const canonical = new URL(pathname, Astro.site);
const ogLocale = (l: Locale) => htmlLang[l].replace('-', '_');
const ogImageUrl = new URL(ogImage, Astro.site).href;
// x-default points at the English version, same as the sitemap does.
const xDefault = alt ? (locale === 'en' ? canonical.href : new URL(alt.path, Astro.site).href) : null;
const ga4 = import.meta.env.PROD ? site.ga4 : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={htmlLang[locale]} href={canonical.href} />
    {alt && <link rel="alternate" hreflang={htmlLang[alt.locale]} href={new URL(alt.path, Astro.site).href} />}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {alt && <meta property="og:locale:alternate" content={ogLocale(alt.locale)} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} - ${site.fullName}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            {`
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4);
            // WhatsApp inquiries never reach the site, so count the click itself as the conversion.
            document.addEventListener('click', function (e) {
              var a = e.target instanceof Element ? e.target.closest('a[href^="https://wa.me/"]') : null;
              if (a) gtag('event', 'whatsapp_click', { page_path: location.pathname });
            });
          `}
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:shadow-floating"
    >
      {ui[locale].skip}
    </a>
    <Header locale={locale} pathname={pathname} switchHref={switchHref} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloat locale={locale} href={waHref} />
  </body>
</html>
