---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatePath, htmlLang, type Locale } from '../i18n';
import { ui } from '../ui';
import { site } from '../site';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description = site.description[locale] } = Astro.props;
const pathname = Astro.url.pathname;
const alt = alternatePath(pathname);
const canonical = new URL(pathname, Astro.site);
const ogLocale = (l: Locale) => htmlLang[l].replace('-', '_');
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={htmlLang[locale]} href={canonical.href} />
    {alt && <link rel="alternate" hreflang={htmlLang[alt.locale]} href={new URL(alt.path, Astro.site).href} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {alt && <meta property="og:locale:alternate" content={ogLocale(alt.locale)} />}
    <!-- og:image is added once the default OG image exists (Step 9) -->

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:shadow-floating"
    >
      {ui[locale].skip}
    </a>
    <Header locale={locale} pathname={pathname} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
