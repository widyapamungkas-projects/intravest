---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import HeroCarousel from './HeroCarousel.astro';
import TripFinder from './TripFinder.astro';
import PackagesSection from './PackagesSection.astro';
import DestinationTile from './DestinationTile.astro';
import StoryCard from './StoryCard.astro';
import { routePath, type Locale } from '../i18n';
import { homeCopy } from '../home-copy';
import { homeUiCopy } from '../home-ui-copy';
import { destSlug } from '../dest-copy';
import { storiesCopy } from '../stories-copy';
import { photoOf } from '../photo';
import { getCollection } from 'astro:content';
import homeJson from '../data/home.json';
import { site, whatsappLink } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale];
const u = homeUiCopy[locale];
// The dashboard drops fields left empty, so every field is optional.
const homeData = homeJson as { ctaImage?: string; ctaAlt?: string };
const destEntries = (await getCollection('destinations', ({ id }) => id.startsWith(`${locale}/`))).sort((a, b) => a.data.order - b.data.order);
const destinations = await Promise.all(destEntries.map(async (e) => ({ slug: destSlug(e.id), entry: e, photo: await photoOf('destinations', e) })));
const stories = (await getCollection('stories', ({ id }) => id.startsWith(`${locale}/`)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const labels: Record<string, string> = Object.fromEntries(destinations.map((d) => [d.slug, d.entry.data.title]));
labels.tips = storiesCopy[locale].tipsLabel;
const wa = whatsappLink(site.whatsapp.defaultMessage[locale]);

const outline = 'inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-navy px-5 font-bold text-text transition-colors hover:bg-surface-2 dark:border-border';
const sectionWrap = 'mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20';
const standardIcons = ['home', 'clock', 'check'] as const;
const standardTint = ['bg-navy text-white', 'bg-accent-soft text-accent', 'bg-[#e1f0e8] text-[#2f7a55] dark:bg-success/20 dark:text-success'];
---

<HeroCarousel locale={locale} />
<TripFinder locale={locale} />

<!-- Destinations -->
<section id="destinations">
  <div class={`${sectionWrap} pt-20 sm:pt-24`}>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
      <div>
        <p class="eyebrow">{u.destinations.eyebrow}</p>
        <h2 class="mt-2 text-balance t-h2">{c.destinations.title}</h2>
        <p class="mt-3 max-w-[60ch] text-lg text-muted">{u.destinations.sub}</p>
      </div>
      <a href={routePath(locale, 'destinations')} class={outline}>{u.destinations.seeAll(destinations.length)}<Icon name="arrow" class="size-4" /></a>
    </div>
    <ul class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        destinations.map((d) => (
          <li>
            <DestinationTile
              href={routePath(locale, 'destinations', d.slug)}
              name={d.entry.data.title}
              tagline={d.entry.data.tagline}
              image={d.photo.image}
              imageAlt={d.photo.imageAlt}
              soon={c.destinations.photoSoon}
              explore={u.destinations.explore}
              badge={d.slug === 'bali' ? u.destinations.flagship : undefined}
              class="aspect-[4/3]"
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<PackagesSection locale={locale} />

<!-- Travel Stories -->
{
  stories.length > 0 && (
    <section id="stories">
      <div class={sectionWrap}>
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
          <div>
            <p class="eyebrow">{u.stories.eyebrow}</p>
            <h2 class="mt-2 text-balance t-h2">{u.stories.title}</h2>
            <p class="mt-3 max-w-[60ch] text-lg text-muted">{u.stories.sub}</p>
          </div>
          <a href={routePath(locale, 'travel-stories')} class={outline}>{u.stories.all}<Icon name="arrow" class="size-4" /></a>
        </div>
        <ul class="mt-9 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {stories.map((s) => (
            <li>
              <StoryCard locale={locale} entry={s} categoryLabel={labels[s.data.category] ?? s.data.category} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<!-- The Intravest standard -->
<section class="border-y border-border bg-surface-2">
  <div class={sectionWrap}>
    <div class="text-center">
      <p class="eyebrow mx-auto">{u.standard.eyebrow}</p>
      <h2 class="mt-2 text-balance t-h2">{u.standard.title}</h2>
    </div>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        u.standard.items.map((item, i) => (
          <li class="flex items-start gap-4 rounded-2xl border border-border bg-surface p-6">
            <span class:list={['flex size-12 shrink-0 items-center justify-center rounded-xl', standardTint[i]]}>
              <Icon name={standardIcons[i]} class="size-6" />
            </span>
            <div>
              <h3 class="text-lg font-extrabold tracking-tight">{item.title}</h3>
              <p class="mt-2 text-muted">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Closing CTA -->
<section id="custom" class="relative isolate overflow-hidden bg-navy text-[#f7f6f2]">
  {
    homeData.ctaImage && (
      <>
        <Photo src={homeData.ctaImage} alt="" label="" class="absolute inset-0 -z-10" sizes="100vw" />
        <div class="absolute inset-0 -z-10 bg-navy/85"></div>
      </>
    )
  }
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-10 gap-y-6 px-4 py-16 sm:px-6">
    <div class="min-w-0 flex-1 basis-[26rem]">
      <h2 class="text-balance t-h2 text-white">{c.cta.title}</h2>
      <p class="mt-3 max-w-[54ch] text-lg text-[#e6e9ec]">{c.cta.sub}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={routePath(locale, 'custom-trip')} class="inline-flex min-h-12 items-center justify-center rounded-xl bg-accent px-6 font-bold text-on-accent transition-colors hover:bg-accent-hover">{u.cta.custom}</a>
      <a href={wa} rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/60 px-6 font-bold text-white transition-colors hover:bg-white/10">{c.cta.whatsapp}</a>
    </div>
  </div>
</section>
