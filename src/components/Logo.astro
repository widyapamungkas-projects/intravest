---
import { localizedPath, type Locale } from '../i18n';
import { site } from '../site';
import { getLogo } from '../brand';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const logo = await getLogo();
---

<a
  href={localizedPath(locale, '/')}
  aria-label={site.name}
  class="inline-flex min-h-11 items-center gap-2 rounded-md text-base font-semibold leading-tight tracking-tight text-text sm:text-lg"
>
  {logo ? (
    <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-7 w-auto" />
  ) : (
    <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
      <circle cx="14" cy="14" r="13" fill="var(--accent)" />
      <path d="M8 18c3-7 9-9 13-8-1 5-6 9-13 8z" fill="var(--on-accent)" />
    </svg>
  )}
  <span>{site.name}</span>
</a>
