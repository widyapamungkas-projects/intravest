---
import Logo from './Logo.astro';
import { routePath, type Locale } from '../i18n';
import { navKeys, ui } from '../ui';
import { site, whatsappLink } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const wa = whatsappLink(site.whatsapp.defaultMessage[locale]);
const year = new Date().getFullYear();

const linkClass =
  'inline-flex min-h-11 items-center rounded-md text-muted transition-colors hover:text-text active:text-accent';

// TODO: swap text links for icons once the final social accounts exist.
// An account whose URL is still the '#' placeholder is hidden, so there are no dead links on the live site.
const socials = [
  { name: 'Instagram', href: site.social.instagram },
  { name: 'TikTok', href: site.social.tiktok },
  { name: 'Threads', href: site.social.threads },
].filter((s) => s.href && s.href !== '#');
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo locale={locale} />
      <p class="mt-3 max-w-[32ch] text-muted">{site.tagline}</p>
      <a href={routePath(locale, 'about')} class={`${linkClass} mt-2`}>
        {locale === 'en' ? 'About Intravest' : 'Tentang Intravest'}
      </a>
    </div>

    <nav aria-label={t.footer.explore}>
      <h2 class="mb-2 text-base font-medium">{t.footer.explore}</h2>
      <ul>
        {
          navKeys.map((key) => (
            <li>
              <a href={routePath(locale, key)} class={linkClass}>{t.nav[key]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="mb-2 text-base font-medium">{t.footer.contact}</h2>
      <ul>
        <li><a href={wa} class={linkClass} rel="noopener">WhatsApp {site.whatsapp.display}</a></li>
        <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
      </ul>
      {
        socials.length > 0 && (
          <>
            <h2 class="mb-2 mt-6 text-base font-medium">{t.footer.follow}</h2>
            <ul class="flex flex-wrap gap-x-4">
              {socials.map((s) => (
                <li><a href={s.href} class={linkClass} rel="noopener">{s.name}</a></li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-5 text-sm text-muted sm:px-6">
      &copy; {year} {site.name} ({site.fullName}). {t.footer.rights}
    </p>
  </div>
</footer>
