---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { routePath, type Locale } from '../i18n';
import { navKeys, ui } from '../ui';
import { destSlug } from '../dest-copy';
import { tourSlug } from '../tour-copy';
import { site, whatsappLink } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const wa = whatsappLink(site.whatsapp.defaultMessage[locale]);
const year = new Date().getFullYear();
const destinations = (await getCollection('destinations', ({ id }) => id.startsWith(`${locale}/`))).sort((a, b) => a.data.order - b.data.order);
const tours = (await getCollection('tours', ({ id }) => id.startsWith(`${locale}/`))).sort((a, b) => a.data.order - b.data.order);

// An account whose URL is not set is hidden, so there are no dead links on the live site.
const socials = [
  { name: 'Instagram', icon: 'instagram', href: site.social.instagram },
  { name: 'TikTok', icon: 'tiktok', href: site.social.tiktok },
  { name: 'Threads', icon: 'threads', href: site.social.threads },
].filter((s) => s.href && s.href !== '#') as { name: string; icon: 'instagram' | 'tiktok' | 'threads'; href: string }[];

const link = 'inline-flex min-h-11 items-center gap-2.5 rounded-md text-[#dce3e7] transition-colors hover:text-white';
const h2 = 'mb-3 text-xs font-extrabold uppercase tracking-[0.12em] text-white';
---

<footer class="bg-navy-deep text-[#c4ced4]">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_0.8fr]">
    <div>
      <Logo locale={locale} invert />
      <p class="mt-3 max-w-[34ch]">{site.tagline}</p>
      <div class="mt-5 rounded-2xl border border-white/15 bg-white/5 p-4">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.1em] text-white">{t.footer.payTitle}</p>
        <p class="mt-1.5 text-sm leading-relaxed">{t.footer.payBody}</p>
      </div>
    </div>

    <div>
      <h2 class={h2}>{t.footer.contact}</h2>
      <ul>
        <li><a href={wa} class={`${link} font-semibold text-white`} rel="noopener"><Icon name="whatsapp" />{site.whatsapp.display}</a></li>
        <li><a href={`mailto:${site.email}`} class={link}><Icon name="mail" />{site.email}</a></li>
        {
          site.address && (
            <li class="flex gap-2.5 py-2">
              <Icon name="pin" class="mt-0.5 size-5 shrink-0" />
              <address class="whitespace-pre-line not-italic">{site.address}</address>
            </li>
          )
        }
        <li class="pt-1 text-sm">{t.replyBadge}</li>
      </ul>
    </div>

    <nav aria-label={t.footer.destinations}>
      <h2 class={h2}>{t.footer.destinations}</h2>
      <ul>
        {destinations.map((d) => <li><a href={routePath(locale, 'destinations', destSlug(d.id))} class={link}>{d.data.title}</a></li>)}
        {tours.map((x) => <li><a href={routePath(locale, 'tours', tourSlug(x.id))} class={`${link} font-mono text-sm text-[#f2b8af]`}>{x.data.code}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class={h2}>{t.footer.explore}</h2>
      <ul>
        {navKeys.map((key) => <li><a href={routePath(locale, key)} class={link}>{t.nav[key]}</a></li>)}
      </ul>
      {
        socials.length > 0 && (
          <>
            <h2 class={`${h2} mt-5`}>{t.footer.follow}</h2>
            <ul>
              {socials.map((s) => (
                <li>
                  <a href={s.href} class={link} rel="noopener"><Icon name={s.icon} class="size-[18px]" />{s.name}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6"><p class="text-sm text-[#9fb0b9]">
      &copy; {year} {site.name} ({site.fullName}). {t.footer.rights}
    </p>
    </div>
  </div>
</footer>
