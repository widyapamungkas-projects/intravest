---
// Shared frame for the detail pop-ups: <dialog> with a photo header and a close button.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props { id: string; label: string; image?: any; imageAlt?: string; closeLabel: string; wide?: boolean }
const { id, label, image, imageAlt, closeLabel, wide = false } = Astro.props;
---
<dialog id={id} aria-labelledby={`${id}-title`} class:list={['m-auto max-h-[calc(100dvh-2rem)] w-[min(calc(100%-1.5rem),var(--w))] overflow-hidden rounded-2xl border border-border bg-surface p-0 text-[0.875rem] leading-snug text-text shadow-floating backdrop:bg-navy/70']} style={`--w:${wide ? '52rem' : '38rem'}`}>
  <div class="flex max-h-[calc(100dvh-2rem)] flex-col">
    <div class="relative shrink-0">
      {image ? <Photo src={image} alt={imageAlt} label={label} class="aspect-[16/5] sm:aspect-[16/4] rounded-none! border-0!" sizes="960px" /> : <div class="h-16 bg-navy"></div>}
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/30 to-transparent"></div>
      <form method="dialog" class="absolute right-3 top-3">
        <button class="inline-flex size-11 items-center justify-center rounded-full bg-navy/70 text-white hover:bg-navy" aria-label={closeLabel}><Icon name="close" class="size-[18px]" /></button>
      </form>
      <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:px-7"><slot name="head" /></div>
    </div>
    <div class="overflow-y-auto"><slot /></div>
    <slot name="foot" />
  </div>
</dialog>
