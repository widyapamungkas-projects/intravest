---
// Price table of one package: radio buttons choose the number of adults, the table shows every hotel
// against the six room types, plus the high season surcharge in its own column. Wide screens get a table,
// phones get one card per hotel. Without JavaScript every tier is listed one under the other.
import { TIERS, PRICE_KEYS } from '../pricing-core.mjs';
import { formatValidUntil, type TourPricing } from '../pricing';
import { pricingCopy } from '../pricing-copy';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  slug: string;
  pricing: TourPricing;
  /** Show the title block (the pop-up already has a tab title, the page has a section heading). */
  heading?: boolean;
}
const { locale, slug, pricing, heading = true } = Astro.props;
const c = pricingCopy[locale].table;
const num = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
const uid = `tier-${slug}`;
const colLabel = (k: string) => (c as any)[k] as string;
const isLead = (hotelId: string, tierId: string, key: string) => hotelId === pricing.leadHotel.id && tierId === pricing.leadTierId && key === 'twin';
const leadCell = 'bg-accent-soft font-extrabold text-accent-hover ring-2 ring-inset ring-accent dark:text-accent';
---

<section data-pricing-panel class="grid gap-5">
  {
    heading && (
      <div>
        <h3 class="text-lg font-extrabold">{c.title}</h3>
        <p class="mt-1 text-muted">{c.intro}</p>
      </div>
    )
  }
  {pricing.validUntil && <p class="text-sm font-semibold text-muted">{pricingCopy[locale].validUntil(formatValidUntil(locale, pricing.validUntil))}</p>}

  <fieldset>
    <legend class="mb-2 text-xs font-extrabold uppercase tracking-wider text-muted">{c.tierLegend}</legend>
    <div class="flex flex-wrap gap-2">
      {
        TIERS.map((t) => (
          <label class="relative inline-flex min-h-11 cursor-pointer items-center rounded-full border border-border bg-surface px-4 text-sm font-bold text-text has-[:checked]:border-navy has-[:checked]:bg-navy has-[:checked]:text-white has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-[var(--focus)] dark:has-[:checked]:border-sun dark:has-[:checked]:bg-surface-2 dark:has-[:checked]:text-sun">
            <input type="radio" name={uid} value={t.id} checked={t.id === pricing.leadTierId} class="sr-only" />
            {c.adultsChip(t.label)}
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    TIERS.map((t) => (
      <div data-tier-panel={t.id} class="grid gap-3">
        <p class="text-sm font-bold text-muted">{c.tierFor(t.label)}</p>

        <div class="hidden overflow-x-auto rounded-xl border border-border md:block">
          <table class="w-full text-[13px] tabular-nums">
            <thead>
              <tr class="bg-surface-2 text-right text-xs text-muted">
                <th scope="col" class="px-3 py-3 text-left font-bold">{c.hotel}</th>
                {PRICE_KEYS.map((k) => <th scope="col" class="px-2.5 py-3 font-bold">{colLabel(k)}</th>)}
                <th scope="col" class="border-l-2 border-border bg-sun/20 px-3 py-3 font-bold text-text">{c.highSeason}</th>
              </tr>
            </thead>
            <tbody>
              {pricing.hotels.map((h) => (
                <tr class="border-t border-border text-right">
                  <th scope="row" class="px-3 py-3 text-left font-normal">
                    <span class="block text-sm font-extrabold">{h.name}</span>
                    <span class="block text-xs text-muted">{[h.stars ? c.stars(h.stars) : '', h.area ?? ''].filter(Boolean).join(', ')}</span>
                  </th>
                  {PRICE_KEYS.map((k) => (
                    <td class:list={['px-2.5 py-3', k === 'twin' && 'font-bold', isLead(h.id, t.id, k) && leadCell]}>{num.format(h.prices[t.id]?.[k] ?? 0)}</td>
                  ))}
                  <td class="border-l-2 border-border bg-sun/10 px-3 py-3 font-bold">+{num.format(h.highSeason ?? 0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <ul class="grid gap-3 md:hidden">
          {pricing.hotels.map((h) => (
            <li class="overflow-hidden rounded-xl border border-border">
              <p class="bg-surface-2 px-3.5 py-3">
                <span class="block font-extrabold">{h.name}</span>
                <span class="block text-xs text-muted">{[h.stars ? c.stars(h.stars) : '', h.area ?? ''].filter(Boolean).join(', ')}</span>
              </p>
              <dl>
                {PRICE_KEYS.map((k) => (
                  <div class:list={['flex items-center justify-between border-t border-border px-3.5 py-2.5 text-sm tabular-nums', isLead(h.id, t.id, k) && leadCell]}>
                    <dt>{colLabel(k)}</dt>
                    <dd class:list={['m-0', k === 'twin' ? 'font-extrabold' : 'font-semibold']}>{num.format(h.prices[t.id]?.[k] ?? 0)}</dd>
                  </div>
                ))}
                <div class="flex items-center justify-between border-t-2 border-border bg-sun/10 px-3.5 py-2.5 text-sm tabular-nums">
                  <dt class="font-bold">{c.highSeason}</dt>
                  <dd class="m-0 font-bold">+{num.format(h.highSeason ?? 0)}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="flex items-center gap-2.5 text-sm text-muted">
    <span class="size-[18px] shrink-0 rounded-[5px] border-2 border-accent bg-accent-soft" aria-hidden="true"></span>
    {c.leadLegend}
  </p>

  <div class="grid gap-x-8 gap-y-1.5 border-t border-border pt-4 text-[13px] leading-snug text-muted md:grid-cols-2">
    {c.notes.map((n) => <p><b class="text-text">{n.label}:</b> {n.text}</p>)}
    <p class="md:col-span-2"><b class="text-text">{c.highSeason}:</b> {c.highSeasonNote}{pricing.highSeasonNote ? ` ${pricing.highSeasonNote}` : ''}</p>
  </div>
</section>

<script>
  // Radio buttons pick the tier; the other tier tables are hidden. Without JavaScript all of them stay visible.
  document.querySelectorAll<HTMLElement>('[data-pricing-panel]').forEach((root) => {
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-tier-panel]')];
    const apply = () => {
      const on = radios.find((r) => r.checked)?.value;
      panels.forEach((p) => (p.hidden = p.dataset.tierPanel !== on));
    };
    radios.forEach((r) => r.addEventListener('change', apply));
    apply();
  });
</script>
