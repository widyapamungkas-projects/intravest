---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routePath, type Locale } from '../i18n';
import { aboutCopy } from '../about-copy';
import { homeCopy } from '../home-copy';
import { site, whatsappLink } from '../site';
import Photo from './Photo.astro';
import DestinationTile from './DestinationTile.astro';
import { getCollection } from 'astro:content';
import { photoOf } from '../photo';
import aboutJson from '../data/about.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// The dashboard drops fields left empty, so every field is optional. An empty slot renders nothing.
const a = aboutJson as Record<string, string | undefined>;
// Operating-area photos come from the destination pages (first four that have a photo), so nothing to fill in here.
const destEntries = (await getCollection('destinations', ({ id }) => id.startsWith(`${locale}/`))).sort((x, y) => x.data.order - y.data.order);
const places = await Promise.all(destEntries.map(async (e) => ({ slug: e.id.split('/')[1], name: e.data.title, tagline: e.data.tagline, ...(await photoOf('destinations', e)) })));
const c = aboutCopy[locale];
const wa = whatsappLink(site.whatsapp.defaultMessage[locale]);

const wrap = 'mx-auto max-w-6xl px-4 sm:px-6';
const btnPrimary =
  'inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 font-medium text-on-accent transition-colors hover:bg-accent-hover active:brightness-95';
const btnSecondary =
  'inline-flex min-h-11 items-center justify-center rounded-md border border-border bg-surface px-5 font-medium text-text transition-colors hover:bg-surface-2 active:bg-border';
---

<BaseLayout locale={locale} title={c.metaTitle} description={c.description} waHref={wa}>
  <header class={`${wrap} pb-14 pt-14 sm:pb-20 sm:pt-20`}>
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">{c.eyebrow}</p>
    <h1 class="mt-4 max-w-[19ch] text-balance t-h1">{c.title}</h1>
    <p class="mt-6 max-w-[64ch] text-lg text-muted">{c.intro}</p>
  </header>

  {a.heroImage && (
    <div class={`${wrap} pb-14 sm:pb-20`}>
      <Photo src={a.heroImage} alt={a.heroAlt} label="" hideIfMissing priority sizes="(min-width: 1152px) 1152px, 100vw" class="aspect-[16/9] rounded-lg sm:aspect-[21/9]" />
    </div>
  )}

  <section class="border-t border-border">
    <div class={`${wrap} grid gap-x-20 gap-y-8 py-16 sm:py-20 lg:grid-cols-[0.75fr_1.25fr]`}>
      <h2 class="text-balance t-h2 lg:col-start-1 lg:row-start-1">{c.storyTitle}</h2>
      {a.storyImage && (
        <Photo src={a.storyImage} alt={a.storyAlt} label="" hideIfMissing class="aspect-[4/3] rounded-lg lg:col-start-1 lg:row-start-2" sizes="(min-width: 1024px) 400px, 100vw" />
      )}
      {/* With a photo, the text starts level with the photo's top; without one, level with the title. */}
      <div class={`space-y-5 text-muted lg:col-start-2 ${a.storyImage ? 'lg:row-start-2' : 'lg:row-start-1'}`}>
        {c.storyBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface-2">
    <div class={`${wrap} py-16 sm:py-20`}>
      <h2 class="max-w-[24ch] text-balance t-h2">{c.principlesTitle}</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
        {c.principles.map((item) => (
          <li class="border-t border-border pt-5">
            <h3 class="t-h3">{item.title}</h3>
            <p class="mt-2 text-muted">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-border">
    <div class={`${wrap} grid gap-x-20 gap-y-4 pb-10 pt-16 sm:pt-20 lg:grid-cols-2`}>
      <h2 class="max-w-[22ch] text-balance t-h2 lg:col-start-1 lg:row-start-1">{c.operationsTitle}</h2>
      <p class="text-muted lg:col-start-1 lg:row-start-2">{c.operationsIntro}</p>
      <p class="text-muted lg:col-start-2 lg:row-start-2">{c.note}</p>
    </div>
    <div class={`${wrap} pb-16 sm:pb-20`}>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
        {places.map((p) => (
          <li>
            <DestinationTile
              href={routePath(locale, 'destinations', p.slug)}
              name={p.name}
              tagline={p.tagline}
              image={p.image}
              imageAlt={p.imageAlt}
              soon={homeCopy[locale].destinations.photoSoon}
              compactMobile
              class="aspect-[4/5] sm:aspect-[4/3]"
              sizes="(min-width: 1024px) 370px, 50vw"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-accent-soft">
    <div class={`${wrap} py-14 sm:py-16`}>
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{c.promiseTitle}</p>
      <p class="mt-3 max-w-[56ch] text-balance text-xl font-medium leading-snug sm:text-2xl">{c.promiseBody}</p>
    </div>
  </section>

  <section class="border-t border-border">
    <div class={`${wrap} py-16 sm:py-20`}>
      <h2 class="max-w-[24ch] text-balance t-h2">{c.ctaTitle}</h2>
      <p class="mt-3 text-muted">{c.ctaBody}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={routePath(locale, 'custom-trip')} class={btnPrimary}>{c.ctaPrimary}</a>
        <a href={routePath(locale, 'destinations')} class={btnSecondary}>{c.ctaSecondary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
