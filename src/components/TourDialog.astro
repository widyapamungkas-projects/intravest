---
import { fromAmount, getPricing } from '../pricing';
import PricingPanel from './PricingPanel.astro';
import PriceCalculator from './PriceCalculator.astro';
import { pricingCopy } from '../pricing-copy';
import type { CollectionEntry } from 'astro:content';
import DialogShell from './DialogShell.astro';
import DialogScript from './DialogScript.astro';
import Icon from './Icon.astro';
import { photoOf } from '../photo';
import { routePath, type Locale } from '../i18n';
import { dialogCopy } from '../dialog-copy';
import { formatIDR, tourCopy, tourSlug } from '../tour-copy';
import { site, whatsappLink } from '../site';

interface Props { locale: Locale; entry: CollectionEntry<'tours'> }
const { locale, entry } = Astro.props;
const d = entry.data;
const c = dialogCopy[locale];
const slug = tourSlug(entry.id);
const code = `${d.days}D${d.nights}N`;
const photo = await photoOf('tours', entry);
const base = tourCopy[locale].page.waMessage(d.code, d.title, code);
const pricing = getPricing(slug, d);
const pc = pricingCopy[locale];
const tabBtn = 'inline-flex min-h-10 shrink-0 items-center gap-2 rounded-lg border px-4 text-sm font-bold border-border bg-surface text-text hover:bg-surface-2 aria-selected:border-navy aria-selected:bg-navy aria-selected:text-white dark:aria-selected:border-sun dark:aria-selected:bg-surface-2 dark:aria-selected:text-sun';
const tabHot = 'inline-flex min-h-10 shrink-0 items-center gap-2 rounded-lg border px-4 text-sm font-bold border-accent bg-accent-soft text-accent-hover hover:bg-accent-soft aria-selected:bg-accent aria-selected:text-on-accent dark:text-accent dark:aria-selected:text-on-accent';
const field = 'mt-1 w-full min-h-10 rounded-xl border border-border bg-surface px-3 text-sm text-text placeholder:text-muted';
const lbl = 'block text-xs font-extrabold uppercase tracking-wider text-muted';
---
<DialogShell id={`tour-${slug}`} label={d.title} image={photo.image} imageAlt={photo.imageAlt} closeLabel={c.close} wide>
  <Fragment slot="head">
    <p class="flex items-center gap-2"><span class="rounded-md bg-accent px-2 py-1 font-mono text-xs font-semibold text-on-accent">{d.code}</span><span class="rounded-md bg-white/20 px-2 py-1 text-xs font-bold">{code}</span></p>
    <h3 id={`tour-${slug}-title`} class="mt-2 text-xl font-extrabold tracking-tight text-white sm:text-2xl">{d.title}</h3>
    <p class="mt-1 text-sm text-white/90 sm:text-sm">{c.from} <span class="font-extrabold text-sun tabular-nums">{formatIDR(locale, fromAmount(slug, d).amount)}</span> {c.perPerson}{pricing && <span class="block text-xs text-white/80">{pc.fromCaption(pricing.leadMinPax, pricing.leadHotel.name)}</span>}</p>
  </Fragment>
  <div data-tabs>
    {pricing && (
      <div role="tablist" aria-label={pc.tabsLabel} class="sticky top-0 z-10 flex gap-2 overflow-x-auto border-b border-border bg-surface px-4 py-2.5 sm:px-6">
        <button type="button" role="tab" data-tab="itinerary" aria-selected="true" class={tabBtn}>{pc.tabs.itinerary}</button>
        <button type="button" role="tab" data-tab="prices" aria-selected="false" class={tabBtn}>{pc.tabs.prices}</button>
        <button type="button" role="tab" data-tab="calc" aria-selected="false" class={tabHot}>{pc.tabs.calc}</button>
      </div>
    )}
    <div data-tab-panel="itinerary">
  <div class="grid gap-6 p-4 sm:px-6 lg:grid-cols-[1.4fr_1fr]">
    <div class="grid content-start gap-6">
      <p class="text-muted">{d.summary}</p>
      {d.itinerary.map((day, i) => (
        <div class="flex gap-4">
          <span class="mt-0.5 inline-flex h-6 w-14 shrink-0 items-center justify-center rounded-lg border border-border bg-surface-2 font-mono text-[11px] font-semibold">{c.day(i + 1)}</span>
          <div>
            <h4 class="text-[15px] font-extrabold">{day.title}</h4>
            <ul class="mt-2 grid gap-1.5">{day.plan.map((p) => <li class="flex gap-2.5 text-muted"><span class="mt-[0.6rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{p}</li>)}</ul>
            <p class="mt-2.5 text-sm font-semibold text-muted">{c.meals}: {day.meals}{day.stay ? ` | ${c.stay}: ${day.stay}` : ''}</p>
          </div>
        </div>
      ))}
      <div class="grid gap-5 border-t border-border pt-4 sm:grid-cols-2">
        <div>
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-success">{c.included}</h4>
          <ul class="mt-3 grid gap-2">{d.inclusions.map((x) => <li class="flex gap-2.5 text-muted"><Icon name="check" class="mt-1 size-4 shrink-0 text-success" />{x}</li>)}</ul>
        </div>
        <div>
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-accent">{c.notIncluded}</h4>
          <ul class="mt-3 grid gap-2">{d.exclusions.map((x) => <li class="flex gap-2.5 text-muted"><Icon name="close" class="mt-1 size-4 shrink-0 text-accent" />{x}</li>)}</ul>
        </div>
      </div>
      <p class="rounded-xl border border-border bg-surface-2 p-3.5 text-sm text-muted">{d.priceNote ? `${d.priceNote} ` : ''}{c.payNote}</p>
    </div>

    <form data-inquiry data-base={base} data-labels={JSON.stringify(c.msg)} data-number={site.whatsapp.number} data-email={site.email} data-subject={c.msg.subject(d.title)} class="grid h-fit content-start gap-3.5 rounded-2xl border border-border bg-surface-2 p-5">
      <div class="flex items-baseline justify-between gap-3"><h4 class="text-base font-extrabold">{c.form.title}</h4><span class="text-xs font-semibold text-muted">{c.form.sla}</span></div>
      <label class={lbl}>{c.form.name}<input name="name" autocomplete="name" class={field} /></label>
      <label class={lbl}>{c.form.email}<input name="email" type="email" autocomplete="email" class={field} /></label>
      <div class="grid grid-cols-2 gap-3">
        <label class={lbl}>{c.form.date}<input name="date" class={field} /></label>
        <label class={lbl}>{c.form.pax}<input name="pax" value={c.form.paxValue} class={field} /></label>
      </div>
      <label class={lbl}>{c.form.notes}<textarea name="notes" rows="2" placeholder={c.form.notesPh} class={`${field} py-2`}></textarea></label>
      <div><p class={lbl}>{c.form.preview}</p><pre data-preview class="mt-1 whitespace-pre-wrap rounded-xl border border-border bg-surface p-3 font-mono text-xs text-muted">{base}</pre></div>
      <a data-wa href={whatsappLink(base)} rel="noopener" class="inline-flex min-h-10 items-center justify-center rounded-xl bg-accent px-4 text-sm font-bold text-on-accent hover:bg-accent-hover">{c.form.wa}</a>
      <a data-mail href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-surface px-4 text-sm font-bold hover:bg-surface-2">{c.form.mail}</a>
    </form>
  </div>
    </div>
    {pricing && (
      <div data-tab-panel="prices" hidden class="p-4 sm:px-6"><PricingPanel locale={locale} slug={slug} pricing={pricing} heading={false} /></div>
      <div data-tab-panel="calc" hidden class="p-4 sm:px-6"><PriceCalculator locale={locale} slug={slug} pricing={pricing} base={base} subject={c.msg.subject(d.title)} heading={false} /></div>
    )}
  </div>
  <div slot="foot" class="flex flex-wrap items-center justify-between gap-3 border-t border-border bg-surface-2 p-3 sm:px-6">
    <p class="text-sm text-muted">{c.from} <strong class="text-base tabular-nums text-text">{formatIDR(locale, fromAmount(slug, d).amount)}</strong> {c.perPerson}</p>
    <a href={routePath(locale, 'tours', slug)} class="inline-flex min-h-10 items-center rounded-xl border border-border bg-surface px-4 text-sm font-bold hover:bg-surface-2">{c.fullPage}</a>
  </div>
</DialogShell>
<DialogScript />
<script>
  // Tabs inside a pop-up (Itinerary / Prices / Calculate). Arrow keys move between tabs.
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-tab]');
    const root = b?.closest<HTMLElement>('[data-tabs]');
    if (!b || !root) return;
    root.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === b)));
    root.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((p) => (p.hidden = p.dataset.tabPanel !== b.dataset.tab));
  });
  document.addEventListener('keydown', (e) => {
    const t = (e.target as Element).closest<HTMLElement>('[role="tab"]');
    if (!t || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
    const tabs = [...t.parentElement!.querySelectorAll<HTMLElement>('[role="tab"]')];
    const next = tabs[(tabs.indexOf(t) + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
    next.focus();
    next.click();
  });
</script>
