---
import Logo from './Logo.astro';
import { alternatePath, htmlLang, localeNames, localizedPath, routePath, type Locale } from '../i18n';
import { navKeys, ui } from '../ui';
import { site, whatsappLink } from '../site';

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
const t = ui[locale];

const alt = alternatePath(pathname);
const other: Locale = alt?.locale ?? (locale === 'en' ? 'id' : 'en');
const otherHref = alt?.path ?? localizedPath(other, '/');
const wa = whatsappLink(site.whatsapp.defaultMessage[locale]);

const linkClass =
  'inline-flex min-h-11 items-center rounded-md px-3 text-muted transition-colors hover:bg-surface-2 hover:text-text active:bg-border aria-[current=page]:font-medium aria-[current=page]:text-text';
const iconBtn =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface-2 hover:text-text active:bg-border disabled:pointer-events-none disabled:opacity-50';
const ctaClass =
  'inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 font-medium text-on-accent transition-colors hover:bg-accent-hover active:brightness-95 disabled:pointer-events-none disabled:opacity-50';
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo locale={locale} />

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t.navLabel}>
      {
        navKeys.map((key) => {
          const href = routePath(locale, key);
          return (
            <a href={href} class={linkClass} aria-current={pathname.startsWith(href) ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <div class="flex items-center text-sm" role="group" aria-label={t.language}>
        <span class="inline-flex min-h-11 min-w-11 items-center justify-center font-medium text-text" lang={htmlLang[locale]} aria-current="true">
          {locale.toUpperCase()}
        </span>
        <a
          href={otherHref}
          hreflang={htmlLang[other]}
          lang={htmlLang[other]}
          aria-label={localeNames[other]}
          class={iconBtn}
        >
          {other.toUpperCase()}
        </a>
      </div>

      <button type="button" id="theme-toggle" class={`theme-toggle ${iconBtn}`} aria-label={t.theme}>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <a href={wa} class={`${ctaClass} hidden sm:inline-flex`} rel="noopener">{t.whatsapp}</a>

      <button
        type="button"
        id="menu-toggle"
        class={`lg:hidden ${iconBtn}`}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.menu}
      >
        <svg class="icon-bars" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-x" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-border bg-bg lg:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4 sm:px-6" aria-label={t.navLabel}>
      {
        navKeys.map((key) => {
          const href = routePath(locale, key);
          return (
            <a href={href} class={linkClass} aria-current={pathname.startsWith(href) ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          );
        })
      }
      <a href={wa} class={`${ctaClass} mt-3`} rel="noopener">{t.whatsapp}</a>
    </nav>
  </div>
</header>

<style>
  .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: none;
  }
  .icon-x {
    display: none;
  }
  #menu-toggle[aria-expanded='true'] .icon-bars {
    display: none;
  }
  #menu-toggle[aria-expanded='true'] .icon-x {
    display: block;
  }
</style>

<script>
  const menuBtn = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  };

  menuBtn?.addEventListener('click', () => {
    setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuBtn.focus();
    }
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable, theme just won't persist */
    }
  });
</script>
