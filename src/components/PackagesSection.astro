---
import { fromAmount } from '../pricing';
// Featured Bali packages: duration filter, cards, and an itinerary dialog per package.
// The "View itinerary" link goes to the full tour page; with JavaScript it opens the same itinerary in a dialog.
import { getCollection } from 'astro:content';
import Photo from './Photo.astro';
import TourDialog from './TourDialog.astro';
import Icon from './Icon.astro';
import { photoOf } from '../photo';
import { routePath, type Locale } from '../i18n';
import { homeUiCopy } from '../home-ui-copy';
import { formatIDR, tourSlug } from '../tour-copy';
import { site, whatsappLink } from '../site';
import { tourCopy } from '../tour-copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const u = homeUiCopy[locale].packages;
const tc = tourCopy[locale];
const entries = (await getCollection('tours', ({ id }) => id.startsWith(`${locale}/`)))
  .filter((t) => t.data.destination === 'bali')
  .sort((a, b) => a.data.order - b.data.order);
const tours = await Promise.all(
  entries.map(async (e) => {
    const d = e.data;
    const code = `${d.days}D${d.nights}N`;
    return {
      id: tourSlug(e.id),
      d,
      code,
      photo: await photoOf('tours', e),
      // "Bali Essentials" -> "Essentials" so the chip reads "3D2N Essentials".
      chip: `${code} ${d.title.replace(/^Bali\s+/i, '')}`,
      href: routePath(locale, 'tours', tourSlug(e.id)),
      wa: whatsappLink(tc.page.waMessage(d.code, d.title, code)),
    };
  }),
);
const days = [...new Set(tours.map((t) => t.d.days))];
const chip = 'inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-4 text-sm font-bold text-text transition-colors aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white';
const check = 'inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-[13px] font-semibold';
---

<section id="packages" class="border-y border-border bg-surface-2" data-packages>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <p class="eyebrow">{u.eyebrow}</p>
        <h2 class="mt-2 text-balance t-h2">{u.title}</h2>
        <p class="mt-3 max-w-[60ch] text-lg text-muted">{u.sub}</p>
      </div>
      {
        tours.length > 1 && (
          <div class="flex flex-wrap gap-2" role="group" aria-label={tc.index.filterLabel}>
            <button type="button" class={chip} data-filter="all" aria-pressed="true">{u.all}</button>
            {tours.map((t) => <button type="button" class={chip} data-filter={String(t.d.days)} aria-pressed="false">{t.chip}</button>)}
          </div>
        )
      }
    </div>

    <ul class="mt-9 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        tours.map((t) => (
          <li data-days={t.d.days}>
            <article class="flex h-full w-full flex-col overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="relative">
                <Photo src={t.photo.image} alt={t.photo.imageAlt} label={t.d.title} class="aspect-[16/10] rounded-none! border-0!" fallbackClass="aspect-[16/6] rounded-none!" sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw" />
                <span class="absolute right-3.5 top-3.5 rounded-lg bg-accent px-2.5 py-1.5 font-mono text-xs font-semibold text-on-accent">{t.code}</span>
              </div>
              <div class="flex flex-1 flex-col gap-3 p-6">
                <p><span class="rounded-md bg-navy px-2 py-1 font-mono text-xs font-semibold text-white">{t.d.code}</span></p>
                <h3 class="text-2xl font-extrabold tracking-tight">{t.d.title}</h3>
                <p class="text-muted">{t.d.summary}</p>
                <ul class="flex flex-wrap gap-2">
                  <li class={check}><Icon name="check" class="size-3.5 text-success" />{u.guide}</li>
                  <li class={`${check} tabular-nums`}><Icon name="check" class="size-3.5 text-success" />{u.meals}</li>
                  <li class={check}><Icon name="check" class="size-3.5 text-success" />{u.car}</li>
                </ul>
                <div class="mt-auto border-t border-border pt-4">
                  <p class="flex items-baseline justify-between gap-3">
                    <span class="text-sm font-semibold text-muted">{u.from}</span>
                    <span class="text-2xl font-extrabold tabular-nums">{formatIDR(locale, fromAmount(t.id.split('/').slice(1).join('/'), t.d).amount)} <span class="text-sm font-semibold text-muted">{u.perPerson}</span></span>
                  </p>
                  <div class="mt-4 flex flex-wrap gap-2.5">
                    <a href={t.href} data-dialog={`tour-${t.id}`} class="inline-flex min-h-12 flex-1 basis-32 items-center justify-center rounded-xl border border-navy bg-surface px-4 text-sm font-bold text-text transition-colors hover:bg-surface-2 dark:border-border">{u.view}</a>
                    <a href={t.wa} rel="noopener" class="inline-flex min-h-12 flex-1 basis-32 items-center justify-center rounded-xl bg-accent px-4 text-sm font-bold text-on-accent transition-colors hover:bg-accent-hover">{u.whatsapp}</a>
                  </div>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 hidden rounded-2xl border border-dashed border-border bg-surface p-8 text-muted" data-empty>{u.empty}</p>
    {tours.some((t) => t.d.priceIsDraft) && <p class="mt-5 text-sm text-muted">{u.draft}</p>}
  </div>

  {entries.map((e) => <TourDialog locale={locale} entry={e} />)}
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-packages]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('li[data-days]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const apply = (days: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === days)));
      let shown = 0;
      items.forEach((li) => {
        const on = days === 'all' || li.dataset.days === days;
        li.hidden = !on;
        if (on) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter ?? 'all')));
    // From the trip finder: pick a duration, then the page scrolls here.
    document.addEventListener('intravest:filter', (e) => apply(String((e as CustomEvent).detail || 'all')));
  }
</script>
