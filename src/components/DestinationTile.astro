---
// Destination card: with a photo, the name sits on the photo (dark gradient keeps it readable);
// without one, the placeholder box with the name underneath.
import Photo from './Photo.astro';

interface Props {
  href: string;
  name: string;
  tagline: string;
  image?: string;
  imageAlt?: string;
  soon: string;
  class?: string;
  sizes?: string;
}
const { href, name, tagline, image, imageAlt, soon, class: aspect = 'aspect-[4/3]', sizes } = Astro.props;
---

<a href={href} class="group relative block overflow-hidden rounded-lg">
  {
    image ? (
      <>
        <Photo
          src={image}
          alt={imageAlt}
          label={`${name}: ${soon}`}
          class={`${aspect} transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100`}
          sizes={sizes}
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
        <div class="absolute inset-x-0 bottom-0 p-5 text-white">
          <h3 class="t-h3 text-white group-hover:underline">{name}</h3>
          <p class="mt-1 text-sm text-white/90">{tagline}</p>
        </div>
      </>
    ) : (
      <>
        <Photo label={`${name}: ${soon}`} class={`${aspect} rounded-md`} />
        <h3 class="mt-3 t-h3 group-hover:underline">{name}</h3>
        <p class="mt-1 text-muted">{tagline}</p>
      </>
    )
  }
</a>
