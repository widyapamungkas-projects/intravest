---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationTile from './DestinationTile.astro';
import { routePath, type Locale } from '../i18n';
import { destCopy, destSlug } from '../dest-copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = destCopy[locale];

const entries = (await getCollection('destinations', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout locale={locale} title={c.index.metaTitle} description={c.index.description}>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <h1 class="text-balance t-h1">{c.index.title}</h1>
    <p class="mt-4 text-lg text-muted">{c.index.intro}</p>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((e) => (
          <li>
            <DestinationTile
              href={routePath(locale, 'destinations', destSlug(e.id))}
              name={e.data.title}
              tagline={e.data.tagline}
              image={e.data.image}
              imageAlt={e.data.imageAlt}
              soon={c.page.photoSoon}
              class="aspect-[4/3]"
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
